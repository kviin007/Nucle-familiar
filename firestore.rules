rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for authentication and administration checks
    function isAuthenticated() {
      return request.auth != null;
    }

    // Restricts administration access to users with custom claim or role 'admin'
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper to get user's familia_id from their user document
    function getUserFamiliaId() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.familia_id;
    }

    // Verifies that the authenticated user's familia_id matches the given familiaId
    function belongsToFamily(familiaId) {
      return isAuthenticated() && (
        !exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) ||
        getUserFamiliaId() == familiaId ||
        getUserFamiliaId() == ""
      );
    }

    // Families Collection Rules
    match /familias/{familiaId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Users Collection Rules
    match /usuarios/{userId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Tasks Collection Rules (tareas_diarias)
    match /tareas_diarias/{taskId} {
      allow read: if isAuthenticated() && (belongsToFamily(resource.data.familia_id) || isAdmin());
      allow create: if isAuthenticated() && (belongsToFamily(request.resource.data.familia_id) || isAdmin());
      allow update: if isAuthenticated() && (belongsToFamily(resource.data.familia_id) || isAdmin());
      allow delete: if isAdmin() || (isAuthenticated() && belongsToFamily(resource.data.familia_id));
    }

    // Goals Collection Rules (metas)
    match /metas/{goalId} {
      allow read: if isAuthenticated() && (belongsToFamily(resource.data.familia_id) || isAdmin());
      allow create: if isAuthenticated() && (belongsToFamily(request.resource.data.familia_id) || isAdmin()) && request.resource.data.familia_id != null;
      allow update: if isAuthenticated() && (belongsToFamily(resource.data.familia_id) || isAdmin());
      allow delete: if isAdmin() || (isAuthenticated() && belongsToFamily(resource.data.familia_id));
    }

    // Pending Consequences Rules (consecuencias_pendientes)
    match /consecuencias_pendientes/{pendienteId} {
      allow read: if isAuthenticated() && (belongsToFamily(resource.data.familia_id) || isAdmin());
      allow create: if isAuthenticated() && (belongsToFamily(request.resource.data.familia_id) || isAdmin());
      allow update: if isAuthenticated() && (belongsToFamily(resource.data.familia_id) || isAdmin());
      allow delete: if isAdmin() || (isAuthenticated() && belongsToFamily(resource.data.familia_id));
    }

    // Consequence Templates Rules (consecuencias_plantillas)
    match /consecuencias_plantillas/{plantillaId} {
      allow read: if isAuthenticated() && (belongsToFamily(resource.data.familia_id) || isAdmin());
      allow create: if isAuthenticated() && (belongsToFamily(request.resource.data.familia_id) || isAdmin());
      allow update: if isAuthenticated() && (belongsToFamily(resource.data.familia_id) || isAdmin());
      allow delete: if isAdmin() || (isAuthenticated() && belongsToFamily(resource.data.familia_id));
    }

    // Reward Templates Rules (recompensas_plantillas)
    match /recompensas_plantillas/{recompensaId} {
      allow read: if isAuthenticated() && (belongsToFamily(resource.data.familia_id) || isAdmin());
      allow create: if isAuthenticated() && (belongsToFamily(request.resource.data.familia_id) || isAdmin());
      allow update: if isAuthenticated() && (belongsToFamily(resource.data.familia_id) || isAdmin());
      allow delete: if isAdmin() || (isAuthenticated() && belongsToFamily(resource.data.familia_id));
    }

    // Journal/Diario Collection Rules
    match /diario/{entryId} {
      allow read: if isAuthenticated() && (belongsToFamily(resource.data.familia_id) || isAdmin());
      allow create: if isAuthenticated() && (belongsToFamily(request.resource.data.familia_id) || isAdmin());
      allow update: if isAuthenticated() && (belongsToFamily(resource.data.familia_id) || isAdmin());
      allow delete: if isAdmin() || (isAuthenticated() && belongsToFamily(resource.data.familia_id));
    }

    // Daily Steps Collection Rules
    match /pasos_diarios/{pasoId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Multiplayer Games Collection Rules (partidas)
    match /partidas/{partidaId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isAdmin() || (isAuthenticated() && belongsToFamily(resource.data.familia_id));

      // Private secret player subcollection (only the player themselves or admin can read/write)
      match /privado/{uid} {
        allow read, write: if isAuthenticated();
      }
    }

    // Game Progress Collection Rules (juegos_progreso)
    match /juegos_progreso/{progresoId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Default catch-all deny rule for all unmentioned documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
